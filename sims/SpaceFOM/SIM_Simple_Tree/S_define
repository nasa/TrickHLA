//==========================================================================
// SIM_OBJECT: SpaceFOMTestRefFrameTreeSimObject - An example reference
// frame tree simulation object definition.  This simulation module also
// intantiates two additional reference frames to populate the tree:
// root_ref_frame and leaf_ref_frame.
//==========================================================================
#include "SpaceFOM/TestRefFrameTree.sm"


//==========================================================================
// SIM_OBJECT: THLA_INIT - An example of a TrickHLA multi-phase
// initialization SimObject.
//==========================================================================
class THLAInitSimObject : public Trick::SimObject {

 public:

   bool config_with_default_data;

   THLAInitSimObject( TrickHLA::Federate & thla_fed,
                      unsigned int         _MPI_1   = 100,
                      unsigned int         _MPI_END = P_SF_INIT_POST_MPI   )
      : config_with_default_data( false ),
        federate( thla_fed )
   {
      //--------------------------------------------------------------------
      // NOTE: Initialization phase numbers must be greater than P60
      // (i.e. P_HLA_INIT) so that the initialization jobs run after the
      // P60 THLA.federate->initialize() job.
      //--------------------------------------------------------------------

      // Alternative method: Send and receive all the initialization data.

      // Send all the initialization data.
      P_MPI_1 ("initialization") federate.send_init_data();

      // Wait to receive all the initialization data.
      P_MPI_1 ("initialization") federate.receive_init_data();

      // Do some processing here if needed...

      // Clear remaining initialization sync-points.
      P_MPI_END ("initialization") federate.clear_init_sync_points();
   }

 private:
   // Private internal references to external object instances.
   // These MUST be assigned in the constructor at instantiation.
   TrickHLA::Federate & federate;

   // Do not allow the implicit copy constructor or assignment operator.
   THLAInitSimObject( THLAInitSimObject const & rhs );
   THLAInitSimObject & operator=( THLAInitSimObject const & rhs );

   // Do not allow the default constructor.
   THLAInitSimObject();

};

// Main TrickHLA SimObject.
SpaceFOMSimObject THLA( THLA_DATA_CYCLE_TIME,
                        THLA_INTERACTION_CYCLE_TIME,
                        P_HLA_EARLY,
                        P_HLA_INIT,
                        P_HLA_LATE );

// SimObject used capture simulation specific initialization.
THLAInitSimObject THLA_INIT( THLA.federate );


// FIXME: Need a FrameManager to simplify and coordinate frame propagation.
// Place the frames in associated integration loops.
IntegLoop leaf_loop (INTEG_STEP_TIME) leaf_ref_frame;

// Make the command line argument available to create_connections.
##include "trick/command_line_protos.h"

//==========================================================================
// Create the THLA connections for the SpaceFOM Reference Frame Tree.
//==========================================================================
void create_connections() {

   int     argc = command_line_args_get_argc();
   char ** argv = command_line_args_get_argv();

   // Choose to configure with default data or not.  The default is 'false'.
   THLA_INIT.config_with_default_data = false;

   // Let's check for default data configurations with command line arguments.
   for ( int iinc = 0 ; iinc < argc ; iinc++ ){
      if ( !strcmp( argv[iinc], "--default_data_config" ) ) {
         THLA_INIT.config_with_default_data = true;
      }
   }

   // NOTE: The frame connections are already handled in the TestRefFrameTree.sm
   // connection section.

   // Allocate THLA objects and interactions here if using default_data
   // to configure the TrickHLA objects and interactions.
   if ( THLA_INIT.config_with_default_data ) {

      //
      // This code will only be executed when we want to configure the reference
      // frame tree using default data instead of in the input file.
      //
      // Allocate the HLA objects for the Reference Frame tree.
      TrickHLA::ObjectServices * obj_services = THLA.federate.get_object_service();
      obj_services->obj_count = 2;
      obj_services->objects = (TrickHLA::Object*)trick_MM->declare_var( "TrickHLA::Object",
                                                                        obj_services->obj_count );

      // Assign the HLA objects to the associated frame.
      root_ref_frame.set_object( &(obj_services->objects[0]) );
      leaf_ref_frame.set_object( &(obj_services->objects[1]) );

   }

}
